# Copy to .env and fill in. .env is git-ignored.
# Hugging Face token (https://huggingface.co/settings/tokens) for the food campaign analyst.
NUXT_HF_TOKEN=
NUXT_HF_MODEL=openai/gpt-oss-120b
# Vision model for "Follow your discount" (reads expiry dates from product photos).
NUXT_HF_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct:fastest

# Google sign-in with Firebase Authentication (sidebar "Login"). In the Firebase console: enable
# Authentication → Sign-in method → Google, add your domain under Authentication → Settings →
# Authorized domains (localhost is there by default), then copy the web app settings from
# Project settings → Your apps. These values are public; they are sent to the browser.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# The one owner account (may start refreshes); everyone else who signs in is a "user".
# Required for refreshes: without it nobody is owner. Keep the address out of the repository.
OWNER_EMAIL=

# PostgreSQL for accounts and saved favorites. Local: `docker compose up -d`, then:
DATABASE_URL=postgres://ipromotion:ipromotion@localhost:5434/ipromotion
# Production: a hosted Postgres, e.g. Neon: postgres://user:pass@host/db?sslmode=require

# ── Online (Vercel); leave empty locally ────────────────────────────────────────────────────────
# postgres = keep deals, status and caches in DATABASE_URL instead of data/ files (Vercel functions
# keep no files, and each store is crawled by a different function).
DATA_STORE=

# ── Payments for photo checks (/pricing, src/billing.js) ─────────────────────────────────────────
# Stripe keys (test keys while testing: sk_test_…). Without both, the pricing page shows the plans
# but "Buy" is disabled; free checks still work. Webhook endpoint: <site>/api/billing/webhook,
# event checkout.session.completed. Locally: `stripe listen --forward-to localhost:3000/api/billing/webhook`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: the site's public address for Stripe's return links (default: the request's host).
PUBLIC_URL=
