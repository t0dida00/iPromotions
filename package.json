{
  "name": "ipromotion",
  "version": "1.0.0",
  "description": "Weekly deals crawler for Tokmanni, K-Supermarket and Prisma",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "crawl": "node --env-file-if-exists=.env src/crawl.js",
    "start:sync": "node --env-file-if-exists=.env --env-file=.env.sync src/server.js",
    "crawl:sync": "node --env-file-if-exists=.env --env-file=.env.sync src/crawl.js",
    "clear:sync": "node --env-file-if-exists=.env --env-file=.env.sync scripts/clear-crawl-data.js",
    "postinstall": "playwright install chromium"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@vercel/functions": "^3.10.3",
    "cheerio": "^1.2.0",
    "express": "^5.3.0",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "playwright": "^1.64.1",
    "playwright-core": "^1.64.1",
    "stripe": "^23.0.1"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
